# TrustPact Telegram Bot Configuration
# Lấy Bot Token từ @BotFather trên Telegram:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Tên username của Bot (ví dụ: TrustPactRadarBot)
BOT_USERNAME=TrustPactRadarBot

# URL của Web DApp TrustPact
TRUSTPACT_WEB_URL=http://localhost:3000

# Avalanche Custom L1 RPC (Tùy chọn)
L1_RPC_URL=http://127.0.0.1:9650/ext/bc/trustpact-l1/rpc
SCAM_REGISTRY_L1_ADDRESS=0x52C84043CD9c86523674805113B78444499cB73a
